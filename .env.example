# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env (git-ignored). NEVER use these
# values outside your machine. Production secrets live in a secrets manager.
# ---------------------------------------------------------------------------

# PostgreSQL container (superuser used ONLY by the container init scripts)
POSTGRES_PASSWORD=change-me-local-superuser
POSTGRES_PORT=5432

# Application database and separated credentials
APP_DB_NAME=vrtic
APP_DB_OWNER_PASSWORD=change-me-owner      # Flyway migrations (owns objects)
APP_DB_RUNTIME_PASSWORD=change-me-runtime  # API (RLS enforced)
APP_DB_WORKER_PASSWORD=change-me-worker    # background relay

# Backend
APP_ENV=dev                                # dev | staging | production (seed refuses production)
APP_HTTP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
# Derived JDBC URL used by the backend: jdbc:postgresql://${DB_HOST}:${DB_PORT}/${APP_DB_NAME}
# Web origin allowed for CSRF/Origin checks (Vite dev server)
APP_WEB_ORIGIN=http://localhost:5173

# Argon2id parameters (tune with `./gradlew :benchmarkArgon2` before production; these are dev defaults)
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
